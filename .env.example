# Copy to .env and fill in. Load with: set -a && source .env && set +a
#
# Create an API token under Workspace Settings -> API tokens. The secret is shown once.
# A member-scope token cannot reach the admin endpoints (memberships, audit logs);
# the Discovery API additionally requires an Enterprise plan.

MODE_WORKSPACE=your-workspace
MODE_API_TOKEN=
MODE_API_SECRET=
